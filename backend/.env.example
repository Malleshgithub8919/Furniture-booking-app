# =============================================================================
# Furniture Marketplace API — Environment Variables
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in every value marked REQUIRED.
#   3. Never commit .env to Git. It is already in .gitignore.
#   4. Generate JWT secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (REQUIRED for database features)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# JWT Access Token — REQUIRED. Must be at least 32 characters.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# JWT Refresh Token — REQUIRED. Must be at least 32 characters.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# OTP Configuration
OTP_EXPIRY_MINUTES=10
# OTP Provider: 'console' (simulated) or 'smtp' (email delivery)
OTP_PROVIDER=console

# Optional SMTP email OTP delivery (set OTP_PROVIDER=smtp to enable)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# Use a Google App Password (not your account password) in SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT_MS=10000

# Comma-separated list of allowed frontend origins (no trailing slashes)
CLIENT_ORIGINS=http://localhost:5173

# =============================================================================
# Razorpay & Payment Gateway Configuration (Phase 6)
# =============================================================================
# In production, get these from your Razorpay Dashboard (https://dashboard.razorpay.com).
# In development/test mode, mock payment orders are automatically created if not set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Unpaid online reservation expiry in minutes (releases reserved stock)
PAYMENT_EXPIRY_MINUTES=30
